<Slide style={{ width: '1280px', height: '720px', background: '#F0FDF4', padding: '60px 80px', flexDirection: 'column' }}>
  <Box style={{ flexDirection: 'column', gap: 8, marginBottom: 24 }}>
    <Text style={{ fontSize: 36, color: '#14532D', fontWeight: 'bold' }}>Sumber Energi</Text>
    <Box style={{ width: 80, height: 4, background: '#15803D', borderRadius: 2 }} />
  </Box>
  <Box style={{ flexDirection: 'row', gap: 20, flex: 1 }}>
    <Box style={{ flex: 1, flexDirection: 'column', gap: 16 }}>
      <Box style={{ background: '#FFFFFF', borderRadius: 12, padding: 20, border: '1px solid #D1FAE5', flexDirection: 'row', gap: 16, alignItems: 'center' }}>
        <FAIcon name='sun' style={{ fill: '#F59E0B', width: 40, height: 40 }} />
        <Box><Text style={{ fontSize: 20, color: '#14532D', fontWeight: 'bold' }}>Matahari</Text><Text style={{ fontSize: 16, color: '#6B7280' }}>Sumber energi utama bumi</Text></Box>
      </Box>
      <Box style={{ background: '#FFFFFF', borderRadius: 12, padding: 20, border: '1px solid #D1FAE5', flexDirection: 'row', gap: 16, alignItems: 'center' }}>
        <FAIcon name='wind' style={{ fill: '#3B82F6', width: 40, height: 40 }} />
        <Box><Text style={{ fontSize: 20, color: '#14532D', fontWeight: 'bold' }}>Angin</Text><Text style={{ fontSize: 16, color: '#6B7280' }}>Menggerakkan kincir</Text></Box>
      </Box>
      <Box style={{ background: '#FFFFFF', borderRadius: 12, padding: 20, border: '1px solid #D1FAE5', flexDirection: 'row', gap: 16, alignItems: 'center' }}>
        <FAIcon name='tint' style={{ fill: '#0EA5E9', width: 40, height: 40 }} />
        <Box><Text style={{ fontSize: 20, color: '#14532D', fontWeight: 'bold' }}>Air</Text><Text style={{ fontSize: 16, color: '#6B7280' }}>Pembangkit listrik</Text></Box>
      </Box>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'column', gap: 16 }}>
      <Box style={{ background: '#FFFFFF', borderRadius: 12, padding: 20, border: '1px solid #D1FAE5', flexDirection: 'row', gap: 16, alignItems: 'center' }}>
        <FAIcon name='fire' style={{ fill: '#DC2626', width: 40, height: 40 }} />
        <Box><Text style={{ fontSize: 20, color: '#14532D', fontWeight: 'bold' }}>Bahan Bakar</Text><Text style={{ fontSize: 16, color: '#6B7280' }}>Minyak, kayu, gas</Text></Box>
      </Box>
      <Box style={{ background: '#FFFFFF', borderRadius: 12, padding: 20, border: '1px solid #D1FAE5', flexDirection: 'row', gap: 16, alignItems: 'center' }}>
        <FAIcon name='utensils' style={{ fill: '#7C3AED', width: 40, height: 40 }} />
        <Box><Text style={{ fontSize: 20, color: '#14532D', fontWeight: 'bold' }}>Makanan</Text><Text style={{ fontSize: 16, color: '#6B7280' }}>Energi kimia untuk tubuh</Text></Box>
      </Box>
      <Box style={{ background: '#15803D', borderRadius: 12, padding: 20, flexDirection: 'column', gap: 8 }}>
        <Text style={{ fontSize: 18, color: '#D1FAE5', fontWeight: 'bold' }}>Aktivitas Kelas:</Text>
        <Text style={{ fontSize: 17, color: '#FFFFFF', lineHeight: 1.5 }}>Sebutkan benda di kelas dan dari mana energinya berasal!</Text>
      </Box>
    </Box>
  </Box>
  <Box style={{ marginTop: 12, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 14, color: '#15803D' }}>Sumber: Panduan IPAS Revisi 4, Kemendikdasmen</Text>
    <Text style={{ fontSize: 14, color: '#9CA3AF' }}>Slide 3 &middot; IPAS &middot; Energi Alternatif</Text>
  </Box>
</Slide>
