<Slide style={{ width: '1280px', height: '720px', background: '#F0FDF4', padding: '60px 80px', flexDirection: 'column' }}>
  <Box style={{ flexDirection: 'column', gap: 8, marginBottom: 24 }}>
    <Text style={{ fontSize: 36, color: '#14532D', fontWeight: 'bold' }}>Hemat Energi itu Mudah!</Text>
    <Box style={{ width: 80, height: 4, background: '#15803D', borderRadius: 2 }} />
  </Box>
  <Box style={{ flexDirection: 'row', gap: 24, flex: 1 }}>
    <Box style={{ flex: 1, flexDirection: 'column', gap: 20 }}>
      <Box style={{ background: '#FFFFFF', borderRadius: 16, padding: 28, border: '1px solid #D1FAE5', flexDirection: 'row', gap: 20, alignItems: 'center' }}>
        <Box style={{ width: 64, height: 64, background: '#FEF3C7', borderRadius: 16, justifyContent: 'center', alignItems: 'center' }}>
          <FAIcon name='toggle-off' style={{ fill: '#B45309', width: 36, height: 36 }} />
        </Box>
        <Box style={{ flex: 1 }}>
          <Text style={{ fontSize: 22, color: '#14532D', fontWeight: 'bold' }}>Matikan alat yang tidak terpakai</Text>
          <Text style={{ fontSize: 17, color: '#6B7280', marginTop: 6 }}>Lampu, kipas, TV, AC &mdash; matikan saat meninggalkan ruangan</Text>
        </Box>
      </Box>
      <Box style={{ background: '#FFFFFF', borderRadius: 16, padding: 28, border: '1px solid #D1FAE5', flexDirection: 'row', gap: 20, alignItems: 'center' }}>
        <Box style={{ width: 64, height: 64, background: '#DBEAFE', borderRadius: 16, justifyContent: 'center', alignItems: 'center' }}>
          <FAIcon name='lightbulb' style={{ fill: '#1E40AF', width: 36, height: 36 }} />
        </Box>
        <Box style={{ flex: 1 }}>
          <Text style={{ fontSize: 22, color: '#14532D', fontWeight: 'bold' }}>Gunakan lampu hemat energi</Text>
          <Text style={{ fontSize: 17, color: '#6B7280', marginTop: 6 }}>LED menggunakan lebih sedikit listrik, lebih terang, lebih awet</Text>
        </Box>
      </Box>
    </Box>
    <Box style={{ flex: 1, background: '#15803D', borderRadius: 20, padding: 36, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 20 }}>
      <FAIcon name='bolt' style={{ fill: '#FBBF24', width: 80, height: 80 }} />
      <Text style={{ fontSize: 32, color: '#FFFFFF', fontWeight: 'bold', textAlign: 'center', lineHeight: 1.3 }}>
        "Matikan bila<br/>tak dipakai!"
      </Text>
      <Box style={{ width: 60, height: 3, background: '#86EFAC', borderRadius: 2 }} />
      <Text style={{ fontSize: 18, color: '#D1FAE5', textAlign: 'center', lineHeight: 1.5 }}>
        Langkah kecil,<br/>dampak besar untuk bumi
      </Text>
      <Text style={{ fontSize: 14, color: '#86EFAC' }}>Sumber: Panduan IPAS Revisi 4, Kemendikdasmen</Text>
    </Box>
  </Box>
  <Box style={{ marginTop: 12, flexDirection: 'row', justifyContent: 'flex-end' }}>
    <Text style={{ fontSize: 14, color: '#9CA3AF' }}>Slide 6 &middot; IPAS &middot; Energi Alternatif</Text>
  </Box>
</Slide>
