<Slide style={{ width: '1280px', height: '720px', background: 'linear-gradient(135deg, #15803D 0%, #166534 40%, #14532D 100%)', padding: '60px 80px', flexDirection: 'column', justifyContent: 'center', position: 'relative' }}>
  <Box style={{ position: 'absolute', top: 0, right: 0, width: 350, height: 350, background: 'radial-gradient(circle, rgba(134,239,172,0.12) 0%, transparent 70%)' }} />
  <Box style={{ flexDirection: 'column', gap: 24, zIndex: 1 }}>
    <Box style={{ flexDirection: 'row', gap: 16, alignItems: 'center' }}>
      <Box style={{ width: 8, height: 48, background: '#86EFAC', borderRadius: 4 }} />
      <Text style={{ fontSize: 28, color: '#86EFAC', fontWeight: 'bold' }}>Ayo Bertindak!</Text>
    </Box>
    <Text style={{ fontSize: 48, color: '#FFFFFF', fontWeight: 'bold', lineHeight: 1.2, textShadow: '2px 2px 12px rgba(0,0,0,0.3)' }}>
      Energi alternatif +<br/>hemat energi =<br/><span style={{ color: '#FBBF24' }}>bumi lebih baik</span>
    </Text>
    <Box style={{ width: 120, height: 4, background: '#86EFAC', borderRadius: 2 }} />
    <Box style={{ flexDirection: 'row', gap: 20, marginTop: 8 }}>
      <Box style={{ background: 'rgba(134,239,172,0.15)', borderRadius: 16, padding: '16px 24px', flexDirection: 'column', gap: 8, alignItems: 'center' }}>
        <FAIcon name='tree' style={{ fill: '#86EFAC', width: 36, height: 36 }} />
        <Text style={{ fontSize: 17, color: '#FFFFFF', fontWeight: 'bold' }}>Tanam pohon</Text>
      </Box>
      <Box style={{ background: 'rgba(134,239,172,0.15)', borderRadius: 16, padding: '16px 24px', flexDirection: 'column', gap: 8, alignItems: 'center' }}>
        <FAIcon name='toggle-off' style={{ fill: '#FBBF24', width: 36, height: 36 }} />
        <Text style={{ fontSize: 17, color: '#FFFFFF', fontWeight: 'bold' }}>Matikan alat tak terpakai</Text>
      </Box>
      <Box style={{ background: 'rgba(134,239,172,0.15)', borderRadius: 16, padding: '16px 24px', flexDirection: 'column', gap: 8, alignItems: 'center' }}>
        <FAIcon name='lightbulb' style={{ fill: '#FBBF24', width: 36, height: 36 }} />
        <Text style={{ fontSize: 17, color: '#FFFFFF', fontWeight: 'bold' }}>Lampu hemat energi</Text>
      </Box>
    </Box>
    <Box style={{ background: 'rgba(255,255,255,0.08)', borderRadius: 16, padding: '20px 28px', marginTop: 12 }}>
      <Text style={{ fontSize: 22, color: '#D1FAE5', fontStyle: 'italic', lineHeight: 1.5 }}>
        Refleksi: "Apa yang bisa kulakukan hari ini untuk menjaga bumi?"
      </Text>
    </Box>
  </Box>
  <Box style={{ position: 'absolute', bottom: 32, left: 80, flexDirection: 'row', gap: 16, alignItems: 'center' }}>
    <Text style={{ fontSize: 14, color: '#86EFAC', opacity: 0.7 }}>Sumber: Panduan IPAS Revisi 4, Kemendikdasmen</Text>
    <Text style={{ fontSize: 14, color: '#86EFAC', opacity: 0.5 }}>&middot; EduCraft &middot; IPAS Fase C</Text>
  </Box>
</Slide>
